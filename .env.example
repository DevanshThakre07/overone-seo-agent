# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Crawl overrides (optional; defaults live in config/default.yaml)
SEO_CRAWL_MAX_PAGES=50
SEO_CRAWL_MAX_DEPTH=3
SEO_CRAWL_TIMEOUT=15
SEO_CRAWL_CONCURRENCY=5
SEO_CRAWL_USER_AGENT=SEO-Agent/0.1 (+https://github.com/local/seo-agent)

# Storage — SQLite is the local/dev default
SEO_STORAGE_BACKEND=sqlite
SEO_STORAGE_PATH=data/audits.db
# Production Postgres (either name; SEO_DATABASE_URL wins if both set).
# When set, audits + durable jobs use Postgres; SQLite path is ignored.
# SEO_DATABASE_URL=postgresql://user:pass@host:5432/seo_agent
# DATABASE_URL=postgresql://user:pass@host:5432/seo_agent
# Durable background job workers (POST /audit?background=true)
# SEO_JOB_WORKERS=2

# Playwright (JS-rendered sites). When installed, SPA shells auto-trigger
# Playwright even if this is false. Recommended for React/Vue/Next sites:
#   pip install 'seo-agent[playwright]' && playwright install chromium
#   SEO_PLAYWRIGHT_ENABLED=true
SEO_PLAYWRIGHT_ENABLED=false

# Keyword research API — DataForSEO Keywords Data + Labs
KEYWORD_API_PROVIDER=dataforseo
KEYWORD_API_LOGIN=
KEYWORD_API_PASSWORD=
# Optional overrides (defaults: US / English):
# KEYWORD_LOCATION_CODE=2840
# KEYWORD_LANGUAGE_CODE=en
# Labs (difficulty + related) — same credentials; on by default:
# KEYWORD_LABS_ENABLED=true
# KEYWORD_RELATED_DEPTH=1
# KEYWORD_RELATED_LIMIT=10
# KEYWORD_INCLUDE_RELATED=true
#
# Then:
#   GET /keywords/status
#   GET /keywords/research?keywords=seo%20audit
#   GET /keywords/difficulty?keywords=seo%20audit
#   GET /keywords/related?keyword=seo%20audit

# LLM (Phase 2 — required for seo-optimize / --optimize)
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# FastAPI inbound auth — when set, all routes except /health, /docs, /share,
# /dashboard, and Google OAuth start/callback require:
#   Authorization: Bearer <key>  or  X-API-Key: <key>
# Leave empty for local/dev. REQUIRED before exposing seo-api on the internet.
# SEO_API_KEY=

# --- FP-2 Host (production) ---
# Platforms inject PORT; seo-api respects it. Bind defaults to 0.0.0.0.
# PORT=8000
# SEO_BIND_HOST=0.0.0.0
# Use a volume at /data in Docker, or Postgres:
# SEO_STORAGE_PATH=/data/audits.db
# SEO_DATABASE_URL=postgresql://user:pass@host:5432/seo_agent
# See docs/HOSTING.md for Railway / Render / Fly / VPS.

# Monitoring alerts (schedule/compare audits) — webhook first
# POST JSON when score drops or new critical issues appear vs previous audit.
# SEO_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# SEO_ALERT_SCORE_DROP=5
# SEO_ALERT_ON_NEW_CRITICAL=true
# Status: GET /alerts/status   Dry-run: POST /alerts/test

# PDF reports (optional): pip install 'seo-agent[pdf]'  (fpdf2)
# Then: GET /report/{audit_id}?format=pdf  or  /share/{token}?format=pdf

# Google Search Console (Connect Google for customers)
# You create ONE OAuth client. Customers only click Connect Google — they never
# open Google Cloud Console. Put the downloaded client JSON under secrets/.
# GSC_CLIENT_SECRETS_FILE=secrets/google-oauth-client.json
# GSC_CLIENT_ID=
# GSC_CLIENT_SECRET=
# GSC_REDIRECT_URI=http://localhost:8000/auth/callback
# Hosted: GSC_REDIRECT_URI=https://YOUR_DOMAIN/auth/callback
# GSC_TOKEN_DB_PATH=data/gsc_tokens.db
# In Docker, prefer /data/gsc_tokens.db (same volume as audits).
# GSC_TOKEN_DB_PATH=/data/gsc_tokens.db
#
# OAuth Production (owner-declared; must match Google Cloud Publishing status):
# GSC_OAUTH_PUBLISHING_STATUS=testing
# After you Publish the consent screen + add https redirect:
# GSC_OAUTH_PUBLISHING_STATUS=production
# GSC_REDIRECT_URI=https://YOUR_DOMAIN/auth/callback
# GSC_PRIVACY_POLICY_URL=https://YOUR_DOMAIN/legal/privacy
# GSC_HOMEPAGE_URL=https://YOUR_DOMAIN/
# Checklist: GET /auth/google/production
# Privacy stub (public): GET /legal/privacy
#
# Flow:
#   1) seo-api
#   2) Open http://localhost:8000/auth/google/start?account_id=customer-123
#   3) Customer approves → callback stores their tokens
#   4) GET /gsc/sites?account_id=customer-123
#   5) POST /audit with gsc_account_id=customer-123 to enrich the audit
#   6) GA4 (same OAuth; enable Analytics Admin + Data APIs in Google Cloud):
#        GET /ga4/properties?account_id=customer-123
#        PUT /ga4/preference  {"account_id":"customer-123","property_id":"533500924"}
#        GET /ga4/report?account_id=customer-123   # uses saved preference
#        Or dashboard: pick property by name → Save GA4 default
#      If the account was connected before GA4 shipped, reconnect to grant
#      analytics.readonly.

# PageSpeed Insights (Core Web Vitals) — free API key, no OAuth
# Enable "PageSpeed Insights API" in Google Cloud → create an API key → paste:
# GOOGLE_PAGESPEED_API_KEY=
# PAGESPEED_STRATEGY=mobile
#
# Then:
#   GET /pagespeed/status
#   GET /pagespeed?url=https://example.com
# Audits auto-include PageSpeed on the seed URL when the key is set.

