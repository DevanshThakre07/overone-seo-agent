# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/

# Secrets / local env (never commit real keys)
.env
.env.*
!.env.example
*.pem
*.p12
*.key
credentials*.json
client_secret*.json

# Google OAuth client secrets (never commit)
secrets/

# Tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.DS_Store

# Runtime data / local dumps
data/*
!data/.gitkeep
*.db
*.sqlite3
out/
out.json
optimize.json
*.log

# Local JSON dumps (keep committed fixtures + config)
*.json
!config/*.yaml
!tests/fixtures/**

# Local experiments (not product surface)
3d.html

# hermes-agent lives in a sibling repo — never part of this project
# (this ignore is defensive if someone copies it under SEO-Agent/)
hermes-agent/
../hermes-agent/
